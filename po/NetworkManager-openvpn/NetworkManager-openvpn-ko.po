#: properties/import-export.c:183
#, c-format
msgid "option %s expects between %u and %u argument"
msgid_plural "option %s expects between %u and %u arguments"
msgstr[0] "옵션 %s에는 %u와 %u 인수 사이가 필요합니다."
msgstr[1] "옵션 %s에는 %u와 %u 인수 사이가 필요합니다."

#: properties/import-export.c:188
#, c-format
msgid "option %s expects no arguments"
msgstr "옵션 %s에는 인수가 필요하지 않습니다."

#: properties/import-export.c:190
#, c-format
msgid "option %s expects exactly one argument"
msgid_plural "option %s expects exactly %u arguments"
msgstr[0] "옵션 %s는 하나의 인수만 필요합니다."
msgstr[1] "옵션 %s는 %u개의 인수가 필요합니다."

#: properties/import-export.c:219
#, c-format
msgid "argument %s of “%s” can not be empty"
msgstr "%2$s의 인수 %1$s는 비워둘 수 없습니다."

#: properties/import-export.c:221
#, c-format
msgid "argument of “%s” can not be empty"
msgstr "%s의 인수는 비워둘 수 없습니다."

#: properties/import-export.c:237
#, c-format
msgid "argument %s of “%s” must be UTF-8 encoded"
msgstr "%2$s의 인수 %1$s는 UTF-8 인코딩이여야 합니다."

#: properties/import-export.c:239
#, c-format
msgid "argument of “%s” must be UTF-8 encoded"
msgstr "%s의 인수는 UTF-8 인코딩이여야 합니다."

#: properties/import-export.c:263
#, c-format
msgid "invalid %uth argument to “%s” where number expected"
msgstr "숫자가 필요한 '%2$s'에 대한 %1$u번째 인수가 잘못되었습니다."

#. we don't support these special destinations, as they currently cannot be expressed
#. * in a connection.
#: properties/import-export.c:304
#, c-format
msgid "unsupported %uth argument %s to “%s”"
msgstr "'%3$s'에 대한 지원되지 않는 %1$u번째 인수 %2$s"

#. we also don't support specifing a FQDN.
#: properties/import-export.c:322
#, c-format
msgid ""
"unsupported %uth argument to “%s” which looks like a FQDN but only IPv4 "
"address supported"
msgstr ""
"FQDN 처럼 보이지만 IPv4 주소만 지원되는 '%2$s'에 대한 지원되지 않는 %1$u번째 "
"인수"

#: properties/import-export.c:329
#, c-format
msgid "invalid %uth argument to “%s” where IPv4 address expected"
msgstr "IPv4 주소가 필요한 '%2$s'에 대한 %1$u번째 인수가 잘못되었습니다."

#: properties/import-export.c:354
#, c-format
msgid "invalid %uth key-direction argument to “%s”"
msgstr "'%2$s'에 대한 %1$u번째 키 방향 인수가 잘못되었습니다."

#: properties/import-export.c:368
#, c-format
msgid "invalid %uth argument to “%s”"
msgstr "'%2$s'에 대한 잘못된 %1$u번째 인수"

